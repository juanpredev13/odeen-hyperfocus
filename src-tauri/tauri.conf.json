{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ODEEN",
  "version": "0.1.0",
  "identifier": "com.juanpredev.odeen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ODEEN",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "style-src": "'self' https://fonts.googleapis.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://api.github.com"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://api.github.com ws://localhost:5173 http://127.0.0.1:54321 ws://127.0.0.1:54321"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "shortDescription": "Deep work operating system",
    "linux": {
      "deb": {
        "desktopTemplate": "odeen.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "odeen"
        ]
      }
    }
  }
}
